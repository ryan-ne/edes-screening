# Copy to .env and fill in.
ORG_NAME=Your Organization Name

# Screening source. auto = opensanctions if key set, else mock (demo, fake data)
SCREENER=auto
# Free key for non-profit / non-commercial use: https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# Lists to screen (OpenSanctions dataset IDs, comma separated). Match your donor's requirements.
# SCREENING_DATASETS=us_ofac_sdn,us_ofac_cons,un_sc_sanctions,eu_fsf,gb_fcdo_sanctions,worldbank_debarred,us_sam_exclusions

# Match thresholds (0-1)
POSSIBLE_THRESHOLD=0.5
STRONG_THRESHOLD=0.8

# Optional: Claude AI plain-language summaries of potential matches
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
