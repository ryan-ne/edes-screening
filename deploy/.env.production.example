# Copy to .env on the VPS (same folder as docker-compose.yml) and fill in.

# Your domain, already pointed (DNS A record) at this VPS's IP
DOMAIN=screening.example.org

ORG_NAME=Your Organization Name

# Team login password (12+ chars). Share only with staff who do screening.
APP_PASSWORD=
# Random secret for signing login cookies. Generate with:
#   openssl rand -base64 48
SECRET_KEY=
# Optional: token for scripts calling the API (Authorization: Bearer <token>)
API_TOKEN=

# Screening source
SCREENER=opensanctions
OPENSANCTIONS_API_KEY=
# SCREENING_DATASETS=us_ofac_sdn,us_ofac_cons,un_sc_sanctions,eu_fsf,gb_fcdo_sanctions,worldbank_debarred,us_sam_exclusions

POSSIBLE_THRESHOLD=0.7
STRONG_THRESHOLD=0.9

# Optional AI summaries
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Default screening standard on upload: eu (EU list + EU compliance report) | multi
DEFAULT_PROFILE=eu
